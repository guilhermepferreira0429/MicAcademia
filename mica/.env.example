# MicAcademia — the environment of one server.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Every application container reads this one file. It is the only place secrets
# live; mica/.env is git-ignored and must never be committed.
#
# Pre-production and production use the same compose and differ only here: the
# domains, and whether EasyPay points at sandbox or at the real thing.
#
# Format note: this is read by Docker, not by a shell. Do NOT quote values and
# do not use ${...} — everything after the `=` is taken literally, quotes and
# all. Values cannot span multiple lines.

# ─── Images ──────────────────────────────────────────────────────────────────
# Where the application images live. `./build-push.sh` builds and pushes with
# these names; the server pulls the same ones.
#
# Pin a version in production (MICA_VERSION=1.0.0) so a deploy is a deliberate
# act; `latest` is fine on pre-production, where following the newest build is
# the point.
MICA_IMAGE_PREFIX=ghcr.io/guilhermepferreira0429
MICA_VERSION=latest

# ─── Domains ─────────────────────────────────────────────────────────────────
# These must already point at this server: Caddy requests certificates for them
# on the first boot.
MICA_DOMAIN=academia.microlopes.pt
MICA_API_DOMAIN=api.academia.microlopes.pt
MICA_LIVEKIT_DOMAIN=live.academia.microlopes.pt
MICA_ADMIN_EMAIL=guilhermeferreira@microlopes.pt

# The same names again, as the applications expect them.
ORIGIN=https://academia.microlopes.pt
DASHBOARD_ORIGIN=https://academia.microlopes.pt
PUBLIC_SERVER_URL=https://api.academia.microlopes.pt
TRUSTED_ORIGINS=https://academia.microlopes.pt
PRIVATE_APP_HOST=academia.microlopes.pt
PRIVATE_APP_SUBDOMAINS=app

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -hex 32
PRIVATE_SERVER_KEY=
BETTER_AUTH_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=MicAcademia <geral@nautis.pt>

# ─── Object storage (S3 / R2 / MinIO) ────────────────────────────────────────
# Holds course videos, documents and the recordings of the live classes.
# The Egress container uploads straight here, so the endpoint must be reachable
# from inside Docker as well as from the browser.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_PUBLIC_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_BUCKET_VIDEOS=videos
OBJECT_STORAGE_BUCKET_DOCUMENTS=documents
OBJECT_STORAGE_BUCKET_MEDIA=media
OBJECT_STORAGE_MEDIA_PUBLIC_BASE_URL=

# ─── EasyPay (Multibanco / MB WAY) ───────────────────────────────────────────
# EASYPAY_ENVIRONMENT: sandbox while testing, production when live.
EASYPAY_ENVIRONMENT=production
EASYPAY_ACCOUNT_ID=
EASYPAY_API_KEY=
EASYPAY_WEBHOOK_URL=https://api.academia.microlopes.pt/webhooks/easypay
EASYPAY_WEBHOOK_SECRET=

# ─── Live classes (LiveKit) ──────────────────────────────────────────────────
# The API gives this URL to the browser in the join token, so it is the public
# wss:// address — not the container name.
LIVEKIT_URL=wss://live.academia.microlopes.pt
# The key NAME is an identifier, not a secret; only the secret below is
# confidential. Generate it with:  openssl rand -hex 32
# Both the LiveKit server and the recorder get their configuration from the
# compose, which reads these two lines — so the secret is written once.
LIVEKIT_API_KEY=micacademia
LIVEKIT_API_SECRET=

# ─── Optional ────────────────────────────────────────────────────────────────
# Transcription and AI-assisted course generation.
OPENAI_API_KEY=
UNSPLASH_API_KEY=
LICENSE_KEY=

# Set to true only when you want to start the API without running database
# migrations (they run automatically on every boot otherwise).
SKIP_DB_SETUP=
